# Portainer / Compose inputs for portainer-stack.yml.
# Leave a value blank to use the default documented on that line.
# Do not put secrets in git. Paste values into the Portainer stack environment.
# COMFYUI_*_DIR values are host paths. Blank uses /mnt/tmd-secure/Data/Docker/ComfyUI/...
# If a Portainer key is still a named volume such as comfyui_models, clear it.

# Image pulled by the stack. Default: ghcr.io/monster-spawned-studios/comfyui-mss-login:nvidia
COMFYUI_IMAGE=

# Published port. Default host binds: 100.65.194.86 and 127.0.0.1. Default port: 9008.
# COMFYUI_HOST is the process listen address. Default: 0.0.0.0.
# A value of 127.0.0.1 does not accept Docker published connections.
COMFYUI_BIND_TAILSCALE=
COMFYUI_HOST=
COMFYUI_PORT=

# Resources. Defaults: shm 4g, memory 20g, memswap 24g, CPUs 8 max / 4 reserved, reservation 8G.
SHM_SIZE=
MEM_LIMIT=
MEMSWAP_LIMIT=
CPUS_LIMIT=
CPUS=
MEMORY=

# Watchtower label. Default: false. Portainer's own re-pull is separate.
AUTO_UPDATE=

# GPUs. Defaults: CUDA_VISIBLE_DEVICES=0,1, NVIDIA_VISIBLE_DEVICES=all,
# NVIDIA_DRIVER_CAPABILITIES=compute,utility.
CUDA_VISIBLE_DEVICES=
NVIDIA_VISIBLE_DEVICES=
NVIDIA_DRIVER_CAPABILITIES=
DEVICE_TYPE=
USE_CPU=
FORCE_REINSTALL_TORCH=

# ComfyUI CLI. Defaults: CORS=*, VRAM_RESERVE_GB=1.5, FRONTEND_VERSION=latest.
# --cache-lru 1, --disable-smart-memory, and --reserve-vram are always set.
# PYTORCH_CUDA_ALLOC_CONF default: expandable_segments:True
CORS=
VRAM_RESERVE_GB=
FRONTEND_VERSION=
EXTRA_CLI_ARGS=
PYTORCH_CUDA_ALLOC_CONF=

# Time zone. Default: America/Boise. Container also receives TIME_ZONE from TZ.
TZ=

# Secrets and integrations. Stack names on the left; container names in README.
CIVITAI_TOKEN=
LOGIN_DEBUG_MODE=
SECRET_KEY=
NTFY_AUTH_TOKEN=
HOST_BASE_URL=
PREFER_OPENAI_AGENTS=

# MSS-Login data directory inside the container. Default: /data/mss-login.
# Mapped to container MSS_LOGIN_DATA_DIR. Host files come from COMFYUI_MSS_DATA_DIR.
MSS_DATA_DIR=

# Postgres. Container names: POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DATABASE,
# POSTGRES_USER, POSTGRES_PASSWORD.
POST_HOST=
POST_PORT=
POST_DB=
POST_USER=
POST_PASS=

# WebAuthn and portal defaults. CPE_EMBEDDED_CONVERT default true.
# WEBAUTHN_RP_NAME default: ComfyUI MSS-Login.
CPE_EMBEDDED_CONVERT=
EXPERIMENTAL_LOGIN_BACKGROUND=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGINS=
PYTHONUNBUFFERED=

# Host bind mounts. Defaults are under /mnt/tmd-secure/Data/Docker/ComfyUI/.
COMFYUI_USER_SCRIPTS_DIR=
COMFYUI_MODELS_DIR=
COMFYUI_CUSTOM_NODES_DIR=
COMFYUI_OUTPUT_DIR=
COMFYUI_INPUT_DIR=
COMFYUI_USER_DIR=
COMFYUI_MSS_DATA_DIR=
COMFYUI_EXTRA_MODEL_PATHS=
COMFYUI_BASHRC=
COMFYUI_HF_CACHE_DIR=
COMFYUI_TORCH_CACHE_DIR=

# Folder created only when no MSS-Login package is already mounted. Default: MSS-Login.
# An existing checkout is found by its pyproject name or mss_login.py, not by this name.
MSS_LOGIN_DIR=

# Install custom_nodes/*/requirements.txt at startup. Default: true.
# Failed nodes are logged and skipped. Torch/CUDA wheels stay pinned.
INSTALL_CUSTOM_NODE_DEPS=

# Set to true to start when the mounted MSS-Login HEAD is not the image pin.
# Default: false. The host checkout is never overwritten.
MSS_LOGIN_ALLOW_UNPINNED=

# Set to tunnel to start cloudflared. Leave blank to keep the tunnel off.
# Portainer: add this stack environment variable, then redeploy.
COMPOSE_PROFILES=

# Cloudflare tunnel token. Used only when COMPOSE_PROFILES=tunnel.
# Container name: comfyui-prod-tunnel. Value becomes TUNNEL_TOKEN.
COMFY_TUNNEL_TOKEN=
