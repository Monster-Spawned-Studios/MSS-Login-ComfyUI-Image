# ==============================================================================
# ComfyUI with MSS-Login — Portainer / Docker Compose Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hardware Backend & Container Image Settings
# ------------------------------------------------------------------------------
# Hardware acceleration backend selection (driven entirely by environment variable; no YAML editing):
#   auto   - Universal hardware auto-detection on boot (default; active when unset or 'auto')
#   cuda   - NVIDIA CUDA GPU acceleration (aliases: 'nvidia', 'gpu')
#   rocm   - AMD ROCm acceleration (alias: 'amd')
#   cpu    - CPU execution mode (macOS, CPU-only servers)
# You can also combine profiles with commas, e.g. COMPOSE_PROFILES=cuda,tunnel
COMPOSE_PROFILES=auto

# Sub-image build target stage (when building from deploy/Dockerfile):
#   auto   - Universal hardware auto-detecting image (provisions PyTorch on boot)
#   nvidia - Pre-baked with NVIDIA CUDA PyTorch wheels (cu128/cu130)
#   rocm   - Pre-baked with AMD ROCm PyTorch wheels (rocm6.2.4)
#   cpu    - Pre-baked with lightweight CPU-only PyTorch wheels (macOS / CPU hosts)
IMAGE_TARGET=auto

# Docker image name/tag to pull or tag when building:
#   monster-spawned-studios/comfyui-mss-login:latest (or :auto)
#   monster-spawned-studios/comfyui-mss-login:nvidia
#   monster-spawned-studios/comfyui-mss-login:rocm
#   monster-spawned-studios/comfyui-mss-login:cpu
COMFYUI_IMAGE=monster-spawned-studios/comfyui-mss-login:latest

# Docker Compose image pull policy:
#   build          - Build from source using deploy/Dockerfile; skip pulling from registry (default, prevents pull errors on Portainer GitOps)
#   missing        - Pull pre-built image only if not present locally
#   always         - Always pull pre-built image from registry (requires published image or registry login)
PULL_POLICY=build

# Target accelerator for building from source (deploy/Dockerfile):
# Options: auto (default), cuda (nvidia), rocm (amd), metal (m-series), cpu
ACCELERATOR=auto

# CUDA version override when building or running with CUDA (default: cu128; also cu130)
CUDA_VERSION=cu128

# ROCm version override when building or running with ROCm (default: rocm6.2.4)
ROCM_VERSION=rocm6.2.4

# ------------------------------------------------------------------------------
# 2. Network & Host Port Binding
# ------------------------------------------------------------------------------
# Host IP interface to bind port 8188 to.
# Default 127.0.0.1 restricts direct access to the local host machine.
# Set to 0.0.0.0 to expose ComfyUI across your local network (LAN) or public interfaces.
HOST=127.0.0.1

# Host port mapping for ComfyUI.
PORT=8188

# Public base URL of your ComfyUI instance (e.g. http://127.0.0.1:8188 or https://ai.example.com).
# Essential for proper Content Security Policy (CSP), WebSocket origins, and WebAuthn MFA.
HOST_BASE_URL=http://127.0.0.1:8188

# Allowed CORS origin(s). In production, restrict this to your frontend or proxy domain.
CORS=*

# ------------------------------------------------------------------------------
# 3. MSS-Login Security & WebAuthn MFA
# ------------------------------------------------------------------------------
# 32+ character random secret key for JWT session signing and SQLCipher DB encryption.
# If left blank, an ephemeral secret key is generated and persisted on disk.
# Recommended: generate a strong secret via: openssl rand -hex 32
SECRET_KEY=

# In-container storage directory for MSS-Login database, secrets, avatars, and user configs.
MSS_LOGIN_DATA_DIR=/data/mss-login

# WebAuthn / Passkey Relying Party ID (effective domain, e.g. localhost or ai.example.com).
# Do not include protocol (http/https) or port number. Leave blank to derive from HOST_BASE_URL.
WEBAUTHN_RP_ID=

# Human-readable WebAuthn Relying Party name shown in browser passkey prompts.
WEBAUTHN_RP_NAME=ComfyUI MSS-Login

# Comma-separated list of allowed WebAuthn origins (e.g. http://localhost:8188,https://ai.example.com).
# Leave blank to derive from HOST_BASE_URL.
WEBAUTHN_ORIGINS=

# Enable embedded headless graph parser & browser pool for Comfy Portal mobile apps.
CPE_EMBEDDED_CONVERT=true

# Enable custom owner-managed background media for the MSS-Login screen.
EXPERIMENTAL_LOGIN_BACKGROUND=true

# ------------------------------------------------------------------------------
# 4. Hardware Acceleration & PyTorch Backend
# ------------------------------------------------------------------------------
# Target execution backend (auto, cuda, rocm, xpu, metal, cpu).
# When set to 'auto', entrypoint.sh inspects hardware at runtime and auto-provisions PyTorch.
DEVICE_TYPE=auto

# Force CPU execution mode even if a GPU runtime is detected (0 = GPU if available, 1 = force CPU).
USE_CPU=0

# NVIDIA GPU device index to expose to CUDA (e.g. 0, 1, or 0,1).
CUDA_VISIBLE_DEVICES=0

# NVIDIA driver capabilities for container runtime (default: compute,utility).
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Force re-download and re-installation of PyTorch wheels on next container start (0 or 1).
FORCE_REINSTALL_TORCH=0

# VRAM to reserve for the OS/system in gigabytes (passed to --reserve-vram).
VRAM_RESERVE_GB=1

# ------------------------------------------------------------------------------
# 5. ComfyUI Runtime & Frontend
# ------------------------------------------------------------------------------
# ComfyUI Frontend version tag (e.g. latest, or a specific semantic release).
FRONT_END_VERSION=latest

# Additional CLI flags passed directly to ComfyUI on launch.
EXTRA_CLI_ARGS=--use-pytorch-cross-attention --cache-lru 1

# Prefer OpenAI Agents format when integrating with ComfyUI Copilot (1 = enabled, 0 = disabled).
PREFER_OPENAI_AGENTS=1

# Python standard I/O unbuffered flag for immediate logging output.
PYTHONUNBUFFERED=1

# ------------------------------------------------------------------------------
# 6. Persistent Storage & Volume Mounts
# ------------------------------------------------------------------------------
# Storage location for MSS-Login data (database, user workflows, avatars).
# Set to 'mss_login_data' for a Docker managed named volume, or a host directory path (e.g. ./data/mss-login).
COMFYUI_MSS_DATA_DIR=mss_login_data

# Persistent storage for model downloads, Hugging Face Hub, and PyTorch caches.
# Set to 'comfyui_cache' for a Docker named volume, or a host directory path (e.g. ./data/cache or /mnt/cache).
COMFYUI_CACHE_DIR=comfyui_cache

# Hugging Face and Torch cache directory paths inside the container:
HF_HOME=/data/cache/huggingface
TORCH_HOME=/data/cache/torch
XDG_CACHE_HOME=/data/cache

# Persistent location for user scripts (pre-start hooks, custom node clones, model downloaders).
# Set to 'comfyui_user_scripts' for a named volume, or a host directory path (e.g. ./user-scripts).
COMFYUI_USER_SCRIPTS_DIR=comfyui_user_scripts

# Storage location for models (checkpoints, loras, vae, clip).
# Set to 'comfyui_models' for a Docker managed named volume, or a host path (e.g. /mnt/models or ./models).
COMFYUI_MODELS_DIR=comfyui_models

# Storage location for generated output images.
COMFYUI_OUTPUT_DIR=comfyui_output

# Storage location for uploaded input images.
COMFYUI_INPUT_DIR=comfyui_input

# Storage location for ComfyUI user settings and workspace graphs.
COMFYUI_USER_DIR=comfyui_user

# Storage location for additional custom nodes.
COMFYUI_CUSTOM_NODES_DIR=comfyui_custom_nodes

# Storage location for persisted virtual environment (holds auto-installed PyTorch wheels).
COMFYUI_VENV_DIR=comfyui_venv

# ------------------------------------------------------------------------------
# 7. Resource Limits & Performance
# ------------------------------------------------------------------------------
# Reserved CPU cores for ComfyUI container.
CPUS=4

# Maximum CPU core limit.
CPUS_LIMIT=8

# Reserved memory allocation for ComfyUI container (e.g. 8G).
MEMORY=8G

# Maximum memory limit before OOM killer intervenes (e.g. 20g).
MEM_LIMIT=20g

# Memory + swap limit (e.g. 24g).
MEMSWAP_LIMIT=24g

# Shared memory size (/dev/shm) for PyTorch inter-process communication and DataLoader workers.
SHM_SIZE=4g

# Watchtower label to enable automatic container image updates.
AUTO_UPDATE=true

# ------------------------------------------------------------------------------
# 8. Optional Integrations (Cloudflare Tunnel)
# ------------------------------------------------------------------------------
# Compose profiles to activate. Set to 'tunnel' to launch the cloudflared sidecar.
# COMPOSE_PROFILES=tunnel
COMPOSE_PROFILES=

# Cloudflare Zero Trust Tunnel token (required if COMPOSE_PROFILES=tunnel).
COMFY_TUNNEL_TOKEN=
